# Copy this file to .env and adjust if needed.

# Where your Claude Code data lives. Leave unset to use the default:
#   Mac/Linux: ~/.claude
#   Windows:   %USERPROFILE%\.claude
# Examples:
# CLAUDE_HOME=/Users/you/.claude
# CLAUDE_HOME=C:/Users/you/.claude
# CLAUDE_HOME=//wsl$/Ubuntu/home/you/.claude   (Claude Code running inside WSL)

# Port on your computer. Default: the first free port from 3000 to 3010.
# Use a single port to always get the same address, or another range.
# PORT=3000
# PORT=8080-8090

# News & live facts (release notes, models list, latest version, status).
# These are the only outside requests the dashboard makes. Set to off to disable.
# NEWS=off

# Optional: the folder that holds your code projects, so the dashboard can show
# each project's CLAUDE.md, rules and imports. Also uncomment the
# "/data/projects" volume line in docker-compose.yml. Mounted read-only.
# PROJECTS_HOME=/Users/you/code
# PROJECTS_HOME=C:/Users/you/code
