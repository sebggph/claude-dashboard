{
  "name": "claude-context-dashboard",
  "version": "0.3.0",
  "description": "See how much context your Claude Code sessions use, what fills it, and how to keep it lean.",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "demo": "node build --demo",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "test": "node --test",
    "check": "node scripts/check-content.js",
    "news-snapshot": "node scripts/news-snapshot.js",
    "make-demo": "node scripts/make-demo.js",
    "docker": "node scripts/docker-up.js"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.5"
  }
}
